clear

units                   real
dimension               3
boundary                f p p
atom_style              full


comm_style              tiled
comm_modify             vel yes

neighbor                1.5 bin

# ----------------------------
# Force field
# ----------------------------

pair_style              lj/cut 15.0

bond_style              harmonic

read_data               N2_Shock/data/shock_formed_2.moldata #---------------------------------------------------------------------CHANGE

# ----------------------------
# Simulation parameters
# ----------------------------

variable dt equal 1

timestep ${dt}


# ----------------------------
# Diagnostics
# ----------------------------

log                     N2_Shock/shock_continuation_1.log append


thermo_style            custom step etotal ke pe density temp press
thermo                  1000

dump                    myDump all xyz 5000 N2_Shock/dump.xyz


# ----------------------------
# Boundary conditions
# ----------------------------

fix xwalls all wall/reflect xhi 16000 units box


# Continue piston from previous position

variable piston_start equal 700000 #----------------------------------------------------------------------------------------CHANGE

variable wall_mov equal (step+v_piston_start)*dt*0.01421

fix piston all wall/reflect xlo v_wall_mov units box


# ----------------------------
# Integration
# ----------------------------

fix integrator all nve


# ----------------------------
# Density measurement
# ----------------------------

compute chunks_x all chunk/atom bin/1d x 0.0 10.0 units box

compute temp_chunk all temp/chunk chunks_x temp com yes


fix density_measure all ave/chunk 100 10 1000 chunks_x vx temp density/number density/mass bias temp_chunk norm sample file N2_Shock/dens_contd_2.profile
#-------------------------------------------------------------------------------------------------------------------------------------------CHANGE

# ----------------------------
# Restart files
# ----------------------------

#restart 100000 N2_Shock\restart\shock_combined_1.restart #---------------------------------------------------------------------CHANGE

run 100000 #--------------------------------------------------------------------------------------------------------------------CHANGE

write_restart N2_Shock/restart/final_combined_2.restart#------------------------------------------------------------------------CHANGE
