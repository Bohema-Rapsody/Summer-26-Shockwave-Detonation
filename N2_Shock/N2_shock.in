clear
units                   real
dimension               3
boundary                f p p
atom_style              full

comm_style		        tiled

comm_modify             vel yes
neighbor                1.5 bin

read_data		        N2_shock\emptybox.data extra/bond/per/atom 1#extra memory assigned to creating bonds

region                  gas_init block 2 998 -128 128 -128 128 units box
#region                  gas_init block 10.0 581.5 10.0 581.5 10.0 581.5 units box

variable                Nsteps equal 500000
variable                dt equal 0.1 # fs - note that N2 have a vibrational time period 14.1 fs
variable                seed equal 12345 # random number seed

variable nvt_equilib equal 10000
variable wall_mov equal \ if(step < v_nvt_equilib, 0.0, (step-v_nvt_equilib)*dt*0.014) #piston velocity calculated through Mach = 5.0, gamma = 9/7 = 1.286 (including vibrational mode), T = 300K 

fix                     xwalls all wall/reflect xhi 1000 units box
fix                     piston all wall/reflect xlo v_wall_mov units box

timestep				${dt}

pair_style				lj/cut 15.0
pair_coeff              1 1 0.0739 3.29 # taken from: https://www.sciencedirect.com/science/article/pii/002240739290142Q 
                                        


bond_style				harmonic
bond_coeff				1 1651 1.0977 #seperation and vibrational frequency values taken from https://cccbdb.nist.gov/exp2x.asp?casno=7727379
#harmonic vibration 2359 cm^-1 --> angluar frequency = 0.44466 rad fs^-1 --> standard spring constant vibration

molecule				N2molecule N2_shock\N2mol.data
create_atoms 		    0 random 11076 ${seed} gas_init mol N2molecule ${seed} overlap 2.0# create 7 bar pressure
velocity		        all create 300 ${seed} rot yes mom yes

log                     N2_shock\shock_log.LAMMPS append
thermo_style            custom step etotal ke pe density temp press vol v_wall_mov# what to print
thermo                  1000 # print every 1000 timesteps
dump                    myDump all xyz 1000 N2_shock\dump.xyz # save coordinates every 1000 timesteps

#minimize 		1e-6 1e-6 1000 10000 # shift atom locations to minimize the potential energy of the system. Helps if we accidentally introduce atoms that are overlapping and repel each other very strongly.

fix 			        balance all balance 1000 1.2 rcb # how to assign the domain to different processors

fix                     temp_settle all nvt
run                     ${nvt_equilib}
unfix                   temp_settle

fix			            integrator all nve # set up F=ma integration

compute                 chunks_x all chunk/atom bin/1d x 0.0 4.0
fix                     density_measure all ave/chunk 100 10 1000 chunks_x vx temp density/number norm sample file N2_shock\dens.profile

run						${Nsteps}
print                   "simulation done."










