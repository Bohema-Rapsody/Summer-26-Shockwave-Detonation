

thermo_style            custom step etotal ke pe density temp press
thermo                  1000

dump                    myDump all xyz 5000 N2_Shock/dump/all_dump_Ti.xyz #Dump all atoms
dump                    TiDump titanium xyz 1000 N2_Shock/dump/Ti_dump.xyz #Dump Cu atoms


# ----------------------------
# Boundary conditions
# ----------------------------

#fix xwall_low all wall/reflect xlo 0 units box
fix                     balance all balance 1000 1.2 rcb # how to assign the domain to different processors
fix                     xwall_high all wall/reflect xhi 24000 units box

# Continue piston from previous position

variable                piston_start equal 900000 #----------------------------------------------------------------------------------------CHANGE

variable                wall_mov equal (step+v_piston_start)*dt*14.21

fix                     piston all wall/reflect xlo v_wall_mov units box


# ----------------------------
# Integration
# ----------------------------

fix integrator all nve


# ----------------------------
# Density measurement
# ----------------------------

compute chunks_x nitrogen chunk/atom bin/1d x 0.0 10.0 units box

compute temp_chunk nitrogen temp/chunk chunks_x temp com yes


fix N2_properties nitrogen ave/chunk 100 10 1000 chunks_x vx temp density/number density/mass bias temp_chunk norm sample file N2_Shock/profiles/N2_gas_Ti.profile

#computing Cu particle parameter

compute Ti_com titanium com #com position
variable Ti_vx equal vcm(titanium,x) #Com velcoties
variable Ti_vy equal vcm(titanium,y)
variable Ti_vz equal vcm(titanium,z)
compute Ti_temp titanium temp/com #particle temp -removing com motion
compute Ti_gyr titanium gyration #particle radius of gyration

compute Ti_ke_atom titanium ke/atom #Ke of titanium atoms
compute Ti_ke titanium reduce sum c_Ti_ke_atom #sums to find total

compute Ti_pe_atom titanium pe/atom #as aboce, for PE
compute Ti_pe titanium reduce sum c_Ti_pe_atom

fix Ti_properties titanium ave/time 100 10 1000 c_Ti_com[*] v_Ti_vx v_Ti_vy v_Ti_vz c_Ti_temp c_Ti_ke c_Ti_pe c_Ti_gyr file N2_Shock/profiles/Ti_particle.profile
#-------------------------------------------------------------------------------------------------------------------------------------------CHANGE

# ----------------------------
# Restart files
# ----------------------------

restart 100000 N2_Shock/restart/combined_Ti_N2.restart #---------------------------------------------------------------------CHANGE
#minimize 1e-4 1e-6 100 1000

fix integrator all nve
run 400000 #--------------------------------------------------------------------------------------------------------------------CHANGE
