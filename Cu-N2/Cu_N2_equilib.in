clear
units                   metal
dimension               3
boundary                p p p
atom_style              full



lattice                 fcc 3.6149 #https://periodictable.com/Properties/A/LatticeConstants.html

                                    #---------------------------------------------------------CHANGE
region                  box block -450 450 -450 450 -450 450 units box# ensures a mean free path either side of the nano-particle: lambda = k_b T/(sqrt2 pi d^2 p)
                                                        # under p = 7 bar, T = 300K, d = 3.64, lambda = 100.5 A (+2 for the cutout N2 offset)
create_box              2 box bond/types 1 extra/bond/per/atom 1


region                  CuParticle sphere 0 0 0 150 units box #--------------------------------CHANGE
#Creating simulation geometry #50 Ang radius ~ 13hrs (400000 steps) #25 Ang radius ~ 3hrs (400000 steps)
create_atoms            1 region CuParticle


mass 1 63.546
mass 2 14.007


# Defining simulation variables...
variable                Nsteps equal 5000
variable                seed equal 12345 # random number seed


#Recall metal units:
#Boltzmann: 8.6173e-05 ev/K
#N2:     sigma: 3.29
#        epsilon/k_b: 37.185 K
#        epsilon: 0.00320 eV
#
#Cu:     sigma: 2.314
#        epsilon: 0.167 eV
#        From https://iopscience.iop.org/article/10.1088/0957-4484/17/18/033/pdf
#
#N2-Cu:  sigma: 2.802
#        epsilon: 0.0231 eV



#Defining potential fields
pair_style              hybrid meam lj/cut 15.0

pair_coeff              * * meam Cu-N2/library.meam Cu Cu-N2/Cu.meam Cu NULL# taken from: https://www.ctcms.nist.gov/potentials/entry/2018--Etesami-S-A-Asadi-E--Cu/ 
pair_coeff              2 2 lj/cut 0.0032 3.29
pair_coeff              1 2 lj/cut 0.0231 2.802 # epsilon mix by geometric mean εCuN = sqrt(εCu εN), sigma mix by arithmetic mean σCuN = (σCu+σN)/2
                                                #LJ paramters Cu taken from https://iopscience.iop.org/article/10.1088/0957-4484/17/18/033/pdf

#Simulation computational parameters
comm_style		        tiled
comm_modify             vel yes
fix                     balance all balance 1000 1.2 rcb #Added for processor atom balance
neighbor                2.0 bin
neigh_modify            delay 0 every 1 check yes #comuptational save for rebuilding members (very valid for solid simulations)



#Recording data
#log                     Cu\ideal_law_log.LAMMPS append
log                     Cu-N2/logs/Cu_equilib_300.log append
thermo_style            custom step etotal ke pe density temp press vol lx# what to print
thermo                  1000 # print every 1000 timesteps
dump                    myDump all xyz 5000 Cu-N2/dump/dump.xyz # save coordinates every 5000 timesteps


#Initial relaxation simualtion
timestep		0.005 #to match vibrational period of Cu lattice (0.142ps)

#fix 1 all box/relax iso 0.0 vmax 0.001
#min_style       hftn
minimize        1e-4 1e-6 1000 10000

velocity        all create 300 ${seed} mom yes rot yes

restart         100000  Cu-N2/restart/Cu_equilib_300.restart

fix             Cu_thermostat all nvt temp 300 300 0.1
run             ${Nsteps}
#run 100
unfix           Cu_thermostat


#Now including the N2 gas
timestep		0.001 #note faster periodic vibrations from N2 bonds (0.014ps)

#region          Cu_cut sphere 0 0 0 17
#region          n2_gas subtract box Cu_cut
region          n2_gas sphere 0 0 0 152 side out units box #------------------------------------------------CHANGE

bond_style		harmonic
bond_coeff		1 71.594 1.0977 #updated units to metal
special_bonds   lj/coul 0.0 0.0 1.0

molecule		N2molecule Cu-N2/data/N2mol.data #---------------------------------------------------------------CHANGE
create_atoms    0 random 120814 ${seed} n2_gas mol N2molecule ${seed} overlap 2.0 # ensures approximate set pressure, 7 bar, 300K, volume of box - volume of particle

minimize        1e-4 1e-6 100 1000

group           copper type 1
group           nitrogen type 2

#delete_atoms    overlap 1.5 nitrogen copper units box## instead of minimise?
velocity        nitrogen create 300 ${seed} mom yes rot yes

#Continued minimisation
fix             Cu_CoM copper recenter INIT INIT INIT shift all #ensures CoM remains at initial location

fix             CuN2_thermostat all nvt temp 300 300 0.1
run             75000 #75ps --> 3 collisions ${Nsteps}
unfix           CuN2_thermostat

#N2 equilibrium with thermostat on nano particle
fix             CuN2_equlib all npt temp 300 300 0.1 iso 7.0 7.0 100

run             300000 #300ps --> 15 collisions

unfix           CuN2_equlib
unfix           Cu_CoM

write_data      Cu-N2/data/Cu_equilib_300.moldata

#Simulation continues
#fix			    integrator all nve # set up F=ma integration
#run				${Nsteps}

print           "simulation done."