clear
units                   metal
dimension               3
boundary                p p p 
atom_style              full



#Creating simulation geometry
lattice                 fcc 3.6149 #https://periodictable.com/Properties/A/LatticeConstants.html

region                  box block -60 60 -60 60 -60 60
create_box              2 box bond/types 1 extra/bond/per/atom 1


region                  CuParticle sphere 0 0 0 15
create_atoms            1 region CuParticle

mass 1 63.546
mass 2 14.007


# Defining simulation variables...
variable                Nsteps equal 5000
variable                seed equal 12345 # random number seed


#Recall metal units:
#Boltzmann: 8.6173e-05 ev/K
#N2:     sigma: 3.29
#        epsilon/k_b: 37.185 K
#        epsilon: 0.00320 eV
#
#Cu:     sigma: 2.314
#        epsilon: 0.167 eV
#        From https://iopscience.iop.org/article/10.1088/0957-4484/17/18/033/pdf
#
#N2-Cu:  sigma: 2.802
#        epsilon: 0.0231 eV



#Defining potential fields
pair_style              hybrid meam lj/cut 15.0

pair_coeff              * * meam Cu-N2\library.meam Cu Cu-N2\Cu.meam Cu NULL# taken from: https://www.ctcms.nist.gov/potentials/entry/2018--Etesami-S-A-Asadi-E--Cu/                                        
pair_coeff              2 2 lj/cut 0.0032 3.29
pair_coeff              1 2 lj/cut 0.0231 2.802 # epsilon mix by geometric mean εCuN = sqrt(εCu εN), sigma mix by arithmetic mean σCuN = (σCu+σN)/2
                                                #LJ paramters Cu taken from

#Simulation computational parameters
comm_style		        tiled
comm_modify             vel yes
fix                     balance all balance 100 1.2 rcb #Added for processor atom balance
neighbor                2.0 bin
neigh_modify            delay 0 every 1 check yes #comuptational save for rebuilding members (very valid for solid simulations)



#Recording data
#log                     Cu\ideal_law_log.LAMMPS append
log                     Cu-N2\log.LAMMPS
thermo_style            custom step etotal ke pe density temp press # what to print
thermo                  100 # print every 1000 timesteps
dump                    myDump all xyz 100 Cu-N2\dump.xyz # save coordinates every 1000 timesteps


#Initial relaxation simualtion
timestep				0.005 #to match vibrational period of Cu lattice (0.142ps)

#fix 1 all box/relax iso 0.0 vmax 0.001
#min_style       hftn
minimize        1e-4 1e-6 1000 10000

velocity        all create 300 ${seed} mom yes rot yes dist gaussian

fix             2 all nvt temp 300 300 0.1
run             ${Nsteps}
unfix           2


#Now including the N2 gas
timestep				0.001 #note faster periodic birations from N2 bonds

region          Cu_cut sphere 0 0 0 17
region          n2_gas subtract box Cu_cut


bond_style		harmonic
bond_coeff		1 71.594 1.0977 #updated units to metal

molecule		N2molecule Cu-N2\N2mol.data
create_atoms    0 random 400 ${seed} n2_gas mol N2molecule # ensures set pressure

minimize        1e-4 1e-6 1000 10000

group           nitrogen type 2
velocity        nitrogen create 300 ${seed} mom yes rot yes dist gaussian

#Continued minimisation
fix             2 all nvt temp 300 300 0.1
run             ${Nsteps}
unfix           2

#N2 equilibrium
fix             3 all npt temp 300 300 0.1 press 1.0 1.0 1.0
run             10*${Nsteps}
unfix 3


#Simulation continues
#fix			    integrator all nve # set up F=ma integration
#run				${Nsteps}


print           "simulation done."