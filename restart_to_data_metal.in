clear

units       metal
atom_style  full

read_restart Cu-N2/restart/Cu_equilib_300.restart.100000

# Redefine the force field (required after read_restart)
pair_style              hybrid meam lj/cut 15.0

pair_coeff              * * meam Cu-N2/library.meam Cu Cu-N2/Cu.meam Cu NULL# taken from: https://www.ctcms.nist.gov/potentials/entry/2018--Etesami-S-A-Asadi-E--Cu/ 
pair_coeff              2 2 lj/cut 0.0032 3.29
pair_coeff              1 2 lj/cut 0.0231 2.802 # epsilon mix by geometric mean εCuN = sqrt(εCu εN), sigma mix by arithmetic mean σCuN = (σCu+σN)/2
                                                #LJ paramters Cu taken from https://iopscience.iop.org/article/10.1088/0957-4484/17/18/033/pdf

bond_style		        harmonic
bond_coeff		        1 71.594 1.0977 #updated units to metal
special_bonds           lj/coul 0.0 0.0 1.0# Optional: redefine masses if needed

mass 2 14.007 #N molar mass
mass 1 63.546 #N molar mass


write_data Cu-N2/data/Cu_equilib_300_1.moldata