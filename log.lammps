LAMMPS (30 Mar 2026 - Development - patch_30Mar2026-1985-gadc429695f)
  using 1 OpenMP thread(s) per MPI task
clear
  using 1 OpenMP thread(s) per MPI task

units                   real
dimension               3
boundary                f p p
atom_style              full


comm_style              tiled
comm_modify             vel yes

neighbor                1.5 bin

# ----------------------------
# Force field
# ----------------------------

pair_style              lj/cut 15.0

bond_style              harmonic

read_data               N2_Shock/data/shock_formed_2.data #---------------------------------------------------------------------CHANGE
